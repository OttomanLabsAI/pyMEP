<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheets Full Pipeline"
        Width="660" Height="860" MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Sheets Full Pipeline"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="Chamber plans, then sections, then numbered sheets with the views placed, then the centreline dimensions."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,0">
                <GroupBox Header="Chambers">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Family types"/>
                            <TextBox x:Name="TxtTypeFilter" Grid.Column="1"
                                     TextChanged="on_type_filter"/>
                        </Grid>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,4,0,0" Background="White">
                            <ScrollViewer Height="90"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlTypes"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Search Marks"/>
                            <TextBox x:Name="TxtMarkFilter" Grid.Column="1"
                                     TextChanged="on_mark_filter"/>
                            <Button x:Name="BtnAll" Grid.Column="2"
                                    Content="All" Margin="10,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_all"/>
                            <Button x:Name="BtnNone" Grid.Column="3"
                                    Content="None" Margin="6,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_none"/>
                        </Grid>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,4,0,0" Background="White">
                            <ScrollViewer Height="130"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlChambers"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtCount"
                                   Style="{StaticResource Hint}"
                                   Text=""/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Tick one or more family types, then search the Marks and tick the chambers. All / None act on the chambers shown. Chambers without a Mark are not offered."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Plans and sections">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Source plan"/>
                            <ComboBox x:Name="CmbSourcePlan" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The plan the chamber plans are duplicated from (or whose level and template a fresh plan takes)."/>
                        <TextBlock x:Name="TxtSettingsInfo" Margin="0,8,0,0"
                                   TextWrapping="Wrap" FontFamily="Consolas"
                                   FontSize="11" Text=""/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Plans, sections and sheet layout use the settings each button last remembered - open Chamber Plans, Create Sections or Sheet Setup to change them."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sheets">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Title block"/>
                            <ComboBox x:Name="CmbTitleBlock" Grid.Row="0"
                                      Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Sheet number"/>
                            <TextBox x:Name="TxtNumber" Grid.Row="1"
                                     Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Sheet name"/>
                            <TextBox x:Name="TxtName" Grid.Row="2"
                                     Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="First number"/>
                            <TextBox x:Name="TxtStart" Grid.Column="1"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Chambers per sheet"/>
                            <TextBox x:Name="TxtPerSheet" Grid.Column="3"/>
                            <TextBlock Grid.Column="4"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Scale"/>
                            <ComboBox x:Name="CmbScale" Grid.Column="5"
                                      IsEditable="True"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Write {n} where the number goes, in the sheet number and the sheet name - e.g. LV_Z2_P{n} and LV CHAMBERS ZONE 2 - SECTIONS SHEET {n}. {nn} pads to two digits. Numbers already taken are skipped. Each sheet gets one row per chamber: plan, then sections."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Dimensions">
                    <StackPanel>
                        <CheckBox x:Name="ChkDims" Margin="0,4,0,0"
                                  Content="dimension the new sections (centreline strings above and left of the bank)"
                                  Checked="on_dims" Unchecked="on_dims"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Dimension type"/>
                            <ComboBox x:Name="CmbDimType" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Run pipeline"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
