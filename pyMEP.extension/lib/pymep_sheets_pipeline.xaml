<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheets Full Pipeline"
        Width="700" Height="760" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Sheets Full Pipeline"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="Chamber plans, then sections, then numbered sheets with the views placed, then the centreline dimensions - one undo step."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="14,12,14,0">

            <!-- ============================ 1 CHAMBERS ============================ -->
            <TabItem Header="1  Chambers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Family types"/>
                            <TextBox x:Name="TxtTypeFilter" Grid.Column="1"
                                     TextChanged="on_type_filter"/>
                        </Grid>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,4,0,0" Background="White">
                            <ScrollViewer Height="110"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlTypes"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Search Marks"/>
                            <TextBox x:Name="TxtMarkFilter" Grid.Column="1"
                                     TextChanged="on_mark_filter"/>
                            <Button x:Name="BtnAll" Grid.Column="2"
                                    Content="All" Margin="10,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_all"/>
                            <Button x:Name="BtnNone" Grid.Column="3"
                                    Content="None" Margin="6,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_none"/>
                        </Grid>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,4,0,0" Background="White">
                            <ScrollViewer Height="220"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlChambers"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtCount"
                                   Style="{StaticResource Hint}" Text=""/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Tick family types to narrow the list (none ticked = every chamber), search the Marks, tick the chambers. All / None act on the chambers shown. Chambers without a Mark are not offered - everything is named from it."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 2 PLANS =============================== -->
            <TabItem Header="2  Plans">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">
                        <GroupBox Header="Source plan">
                            <StackPanel>
                                <ComboBox x:Name="CmbSourcePlan"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="The plan each chamber plan is duplicated from - or, when it is a callout or dependent view, the plan whose level and template a fresh plan takes. Its Project / True North orientation decides what counts as 'up' for the crop rotation."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Plan extents">
                            <StackPanel>
                                <RadioButton x:Name="RbExtCrop" GroupName="Ext"
                                             Margin="0,4,0,0"
                                             Content="exact crop around the chamber (no scope box)"
                                             Checked="on_extents"/>
                                <StackPanel x:Name="PnlCrop" Margin="18,2,0,0">
                                    <RadioButton x:Name="RbCropFixed" GroupName="CropSize"
                                                 Margin="0,4,0,0" Content="size (mm)"
                                                 Checked="on_crop_size"/>
                                    <Grid x:Name="PnlCropFixed" Margin="18,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource FieldLabel}"
                                                   Text="Along X"/>
                                        <TextBox x:Name="TxtW" Grid.Column="1"/>
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="16,6,10,0" Text="Along Y"/>
                                        <TextBox x:Name="TxtD" Grid.Column="3"/>
                                    </Grid>
                                    <RadioButton x:Name="RbCropParams" GroupName="CropSize"
                                                 Margin="0,8,0,0"
                                                 Content="from the chamber's parameters plus the clearance (names and clearance on the Sections tab)"
                                                 Checked="on_crop_size"/>
                                </StackPanel>
                                <RadioButton x:Name="RbExtScope" GroupName="Ext"
                                             Margin="0,10,0,0"
                                             Content="scope box: a copy of the seed, applied to the plan"
                                             Checked="on_extents"/>
                                <StackPanel x:Name="PnlScope" Margin="18,2,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource FieldLabel}"
                                                   Text="Seed scope box"/>
                                        <ComboBox x:Name="CmbSeed" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource FieldLabel}"
                                                   Text="Workset"/>
                                        <ComboBox x:Name="CmbWorkset" Grid.Column="1"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Revit's API can copy, move and turn a scope box but cannot resize one, so every box is the seed's size. The workset applies to every box made or moved (workshared models only)."/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Plan view template">
                            <StackPanel>
                                <ComboBox x:Name="CmbPlanTemplate"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Goes on every plan view made. '(same as the active view)' means the source plan's template."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 3 SECTIONS ============================ -->
            <TabItem Header="3  Sections">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">
                        <GroupBox Header="Section box (mm)">
                            <StackPanel>
                                <RadioButton x:Name="RbSizeFixed" GroupName="Size"
                                             Margin="0,4,0,0" Content="type the box"
                                             Checked="on_size_mode"/>
                                <Grid x:Name="PnlFixed" Margin="18,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Offset"/>
                                    <TextBox x:Name="TxtOffset" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Height"/>
                                    <TextBox x:Name="TxtHeight" Grid.Column="3"/>
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Depth"/>
                                    <TextBox x:Name="TxtDepth" Grid.Column="5"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="18,4,0,0"
                                           Text="OFFSET from the chamber centre to each section plane, total HEIGHT centred on the chamber, DEPTH from the plane inward. Width follows the chamber footprint plus 500 mm each side."/>
                                <RadioButton x:Name="RbSizeParams" GroupName="Size"
                                             Margin="0,10,0,0"
                                             Content="size from the chamber's parameters plus a clearance"
                                             Checked="on_size_mode"/>
                                <Grid x:Name="PnlParams" Margin="18,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Along X"/>
                                    <TextBox x:Name="TxtParamX" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Along Y"/>
                                    <TextBox x:Name="TxtParamY" Grid.Row="0" Grid.Column="3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Height"/>
                                    <TextBox x:Name="TxtParamH" Grid.Row="0" Grid.Column="5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Clearance each side (mm)"/>
                                    <TextBox x:Name="TxtClear" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="18,4,0,0"
                                           Text="Names of the chamber's length parameters (instance first, then type). Each section is the chamber plus the clearance on every side. These names and the clearance also feed the plan crop when the Plans tab says 'from the chamber's parameters'. A chamber missing a parameter falls back to its bounding box and is reported."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Section type">
                            <StackPanel>
                                <CheckBox x:Name="ChkSameType" Margin="0,4,0,0"
                                          Content="same section type for every side"
                                          Checked="on_same_changed"
                                          Unchecked="on_same_changed"/>
                                <ComboBox x:Name="CmbTypeAll" Margin="0,6,0,0"/>
                                <Grid x:Name="PnlPerSide" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}" Text="SIDE A"/>
                                    <ComboBox x:Name="CmbTypeA" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}" Text="SIDE B"/>
                                    <ComboBox x:Name="CmbTypeB" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}" Text="SIDE C"/>
                                    <ComboBox x:Name="CmbTypeC" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}" Text="SIDE D"/>
                                    <ComboBox x:Name="CmbTypeD" Grid.Row="3" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Per-side types go by the FINAL letter of each section, i.e. the letters left after empty sides are dropped."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Pipework check">
                            <StackPanel>
                                <CheckBox x:Name="ChkCutOnly" Margin="0,4,0,0"
                                          Content="only create sides whose section plane cuts pipework"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Sides that cut nothing are not created and the survivors are named SIDE A, B, C... in order. If no side of a chamber cuts anything, all four are kept."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 4 SHEETS ============================== -->
            <TabItem Header="4  Sheets">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">
                        <GroupBox Header="Sheets">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Title block"/>
                                    <ComboBox x:Name="CmbTitleBlock" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Sheet number"/>
                                    <TextBox x:Name="TxtNumber" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Sheet name"/>
                                    <TextBox x:Name="TxtName" Grid.Row="2" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="First number"/>
                                    <TextBox x:Name="TxtStart" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Chambers per sheet"/>
                                    <TextBox x:Name="TxtPerSheet" Grid.Column="3"/>
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="16,6,10,0" Text="Scale"/>
                                    <ComboBox x:Name="CmbScale" Grid.Column="5" IsEditable="True"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Write {n} where the number goes, in the sheet number and the sheet name - e.g. LV_Z2_P{n} and LV CHAMBERS ZONE 2 - SECTIONS SHEET {n}. {nn} pads to two digits. Numbers already taken are skipped."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Layout on each sheet">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource FieldLabel}" Text="Gap (mm)"/>
                                    <TextBox x:Name="TxtGap" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="14,6,10,0" Text="Left margin"/>
                                    <TextBox x:Name="TxtLeft" Grid.Column="3"/>
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="14,6,10,0" Text="Top margin"/>
                                    <TextBox x:Name="TxtTop" Grid.Column="5"/>
                                    <TextBlock Grid.Column="6"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="14,6,10,0" Text="Title room"/>
                                    <TextBox x:Name="TxtLabel" Grid.Column="7"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Plan template"/>
                                    <ComboBox x:Name="CmbSheetPlanTemplate" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Section template"/>
                                    <ComboBox x:Name="CmbSheetSectionTemplate" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Viewport type"/>
                                    <ComboBox x:Name="CmbViewportType" Grid.Row="2" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Each sheet gets one row per chamber: the plan first, then the sections A, B, C... from the top-left, wrapping when a row is too wide. Templates are applied to the placed views before the scale is set; the viewport type sets the title under each view."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 5 DIMENSIONS ========================== -->
            <TabItem Header="5  Dimensions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">
                        <GroupBox Header="Centreline dimensions">
                            <StackPanel>
                                <CheckBox x:Name="ChkDims" Margin="0,4,0,0"
                                          Content="dimension the new sections"
                                          Checked="on_dims" Unchecked="on_dims"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Dimension type"/>
                                    <ComboBox x:Name="CmbDimType" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Two chained dimensions through the pipe centrelines in every new section: the column spacing above the bank and the row spacing to its left."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Foreground="#B00020" TextWrapping="Wrap"
                           VerticalAlignment="Center" Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnGo" Content="Run pipeline"
                            Style="{StaticResource DialogButton}" IsDefault="True"
                            Click="on_go"/>
                    <Button x:Name="BtnCancel" Content="Cancel"
                            Style="{StaticResource DialogButton}" IsCancel="True"
                            Click="on_cancel"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
