<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Inflow to Collector"
        Width="540" Height="640" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Connect Inflow to Collector"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="&#8212;"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,12">
            <GroupBox Header="Main pipe">
                <StackPanel>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Pipes workset"/>
                        <ComboBox x:Name="CmbPipesWorkset" Grid.Column="1"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Which workset the COLLECTOR pipes live on - only its pipes can catch a node's ray (ignored when one main is forced by selection)."/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Diameter (mm)"/>
                        <TextBox x:Name="TxtMainDia" Grid.Column="1"/>
                    </Grid>
                    <CheckBox x:Name="ChkRegrade" IsChecked="False"
                              Content="Re-grade the main at its own gradient first"
                              Margin="0,8,0,0"
                              Checked="on_regrade" Unchecked="on_regrade"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Ratio  1 :"/>
                        <TextBox x:Name="TxtMainSlope" Grid.Column="1"
                                 IsEnabled="False"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Keep as is:"/>
                        <RadioButton x:Name="RadMainUpper" Content="Upper end"
                                     GroupName="mainkeep" IsEnabled="False"
                                     Margin="0,6,18,0"/>
                        <RadioButton x:Name="RadMainLower" Content="Lower end"
                                     GroupName="mainkeep" IsChecked="True"
                                     IsEnabled="False" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtMainHint"
                               Style="{StaticResource Hint}"
                               Text="&#8212;"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Branch pipes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Gradient  1 :"/>
                    <TextBox x:Name="TxtSlope" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Fixed dia (mm)"/>
                    <TextBox x:Name="TxtFixedDia" Grid.Row="1"
                             Grid.Column="1"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Pipe type"/>
                    <ComboBox x:Name="CmbPipeType" Grid.Row="2"
                              Grid.Column="1"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="System"/>
                    <ComboBox x:Name="CmbSysType" Grid.Row="3"
                              Grid.Column="1"/>
                    <CheckBox x:Name="ChkAuto" Grid.Row="4" Grid.Column="0"
                              Grid.ColumnSpan="3" IsChecked="True"
                              Content="Upstream invert: keep it where it currently is (meet the main as it lies)"
                              Margin="0,8,0,0"
                              Checked="on_auto" Unchecked="on_auto"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Invert level (m)"/>
                    <TextBox x:Name="TxtInvert" Grid.Row="5" Grid.Column="1"
                             IsEnabled="False"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                               Style="{StaticResource Hint}"
                               Text="Each node gets a drop pipe, a bend, and a run falling at the gradient into a tee on the main. 'Fixed dia' (when set) overrides 'Dia from' for every node; pipe type and system default to the main's own. Untick the invert box to pin the elbow invert at an absolute level for every node."/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Node family">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Category"/>
                    <ComboBox x:Name="CmbCat" Grid.Row="0" Grid.Column="1"
                              SelectionChanged="on_cat_changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Family"/>
                    <ComboBox x:Name="CmbFam" Grid.Row="1" Grid.Column="1"
                              SelectionChanged="on_fam_changed"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Type"/>
                    <ComboBox x:Name="CmbType" Grid.Row="2" Grid.Column="1"
                              SelectionChanged="on_type_changed"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Node workset"/>
                    <ComboBox x:Name="CmbNodeWorkset" Grid.Row="5"
                              Grid.Column="1"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Search"/>
                    <TextBox x:Name="TxtSearch" Grid.Row="3" Grid.Column="1"
                             TextChanged="on_search"/>
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Dia from"/>
                    <ComboBox x:Name="CmbDiaParam" Grid.Row="4"
                              Grid.Column="1"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource Hint}"
                               Text="Search matches every category / family / type at once (clear it to go back to the three lists). 'Dia from' picks WHICH family parameter carries the pipe diameter - the type's numeric parameters are listed with a sample value, plus the outlet connector when the family has one."/>
                </Grid>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnConnect" Content="Connect"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_connect"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
