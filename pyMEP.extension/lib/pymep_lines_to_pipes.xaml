<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lines to Pipes"
        Width="520" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Lines to Pipes"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="&#8212;"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,12">
            <GroupBox Header="Which lines">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Line style"/>
                    <ComboBox x:Name="CmbStyle" Grid.Row="0" Grid.Column="1"
                              SelectionChanged="on_filter_changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Workset"/>
                    <ComboBox x:Name="CmbWorkset" Grid.Row="1" Grid.Column="1"
                              SelectionChanged="on_filter_changed"/>
                    <TextBlock x:Name="TxtCount" Grid.Row="2" Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Style="{StaticResource Hint}" Text=""/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Pipes to build">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="System type"/>
                    <ComboBox x:Name="CmbSysType" Grid.Row="0"
                              Grid.Column="1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Pipe segment"/>
                    <ComboBox x:Name="CmbSegment" Grid.Row="1"
                              Grid.Column="1"
                              SelectionChanged="on_segment_changed"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Diameter (mm)"/>
                    <ComboBox x:Name="CmbDia" Grid.Row="2" Grid.Column="1"
                              IsEditable="True"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Pipe type"/>
                    <ComboBox x:Name="CmbPipeType" Grid.Row="3"
                              Grid.Column="1"/>
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Gradient 1 :"/>
                    <TextBox x:Name="TxtSlope" Grid.Row="4" Grid.Column="1"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Outfall invert (m)"/>
                    <TextBox x:Name="TxtInvert" Grid.Row="5" Grid.Column="1"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource Hint}"
                               Text="The diameter list holds the chosen segment's catalogued sizes (type any other value if you must). Pipe type is only needed when the model has more than one - '(automatic)' uses the first."/>
                </Grid>
            </GroupBox>

            <TextBlock Style="{StaticResource Hint}"
                       Text="After OK, click one of the lines NEAR ITS OUTFALL END. Every pipe falls toward that point at the gradient; the outfall itself sits at the invert given above. Lines that cross or end on another line are teed into it at the level of the run they meet; lines meeting end to end are elbowed. A line that touches nothing is reported and skipped."/>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCreate" Content="Create"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_create"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
