<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configurations"
        Width="560" Height="440" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Fence Configurations"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="Named set-ups used by Place New Fence and Update Fence."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <ListBox x:Name="LstConfigs" Height="220"
                     MouseDoubleClick="on_edit"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnAdd" Content="Add new"
                        Style="{StaticResource DialogButton}"
                        Click="on_add"/>
                <Button x:Name="BtnEdit" Content="Edit"
                        Style="{StaticResource DialogButton}"
                        Click="on_edit"/>
                <Button x:Name="BtnRemove" Content="Remove"
                        Style="{StaticResource DialogButton}"
                        Click="on_remove"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Add new and Edit open the configuration editor (double-click a row edits it too). Remove deletes the picked one - the last one standing resets to 'Default'. Configurations live in pyMEP settings and survive updates; Update Fence re-reads them, so an edit here re-spaces, re-rotates, re-posts or re-founds its fences on the next update."/>
            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,6,0,0" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_close"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
