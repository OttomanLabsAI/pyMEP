<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configurations"
        Width="560" Height="440" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Fence Configurations"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="Named set-ups used by Place New Fence and Update Fence."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <ListBox x:Name="LstConfigs" Height="220"
                     MouseDoubleClick="on_edit"
                     SelectionChanged="on_row_selected"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="ChkMark"
                          VerticalAlignment="Center"
                          Content="populate the MARK parameter"
                          Checked="on_mark_toggle"
                          Unchecked="on_mark_toggle"
                          ToolTip="EVERY post + foundation gets a Mark: Fence Network numbers CLOCKWISE from the start of the top-priority line (FF1, FF2, ...); lines of another configuration branching off the chain get their own system - corner mark + letter + count (FF7A1, FF7A2; a second branch FF7B1). Place New Fence numbers from the line's start. Takes effect on the next model / Update Fence run."/>
                <TextBlock Text="prefix" Margin="16,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtMarkPrefix" Width="90"
                         Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="on_mark_prefix"
                         ToolTip="Lands in front of every number: FF -> FF1, FF2..."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="ChkToc"
                          VerticalAlignment="Center"
                          Content="populate TOC"
                          Checked="on_toc_toggle"
                          Unchecked="on_toc_toggle"
                          ToolTip="Every FOUNDATION gets the equation's value written into the named parameter - on placing, moving and rebuilding."/>
                <TextBlock Text="parameter" Margin="16,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTocParam" Width="90"
                         Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="on_toc_param"/>
                <TextBlock Text="equation" Margin="16,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTocFormula" Width="150"
                         Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="on_toc_formula"
                         ToolTip="Evaluated per foundation. Variables: z = ground level at the post (mm, survey), e / n = easting / northing (metres); abs, min, max, round and the math functions work. Empty = z itself. Example: z + 50"/>
            </StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnUp" Content="Move up"
                            Style="{StaticResource DialogButton}"
                            Margin="0,0,0,0" Click="on_up"/>
                    <Button x:Name="BtnDown" Content="Move down"
                            Style="{StaticResource DialogButton}"
                            Click="on_down"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnAdd" Content="Add new"
                            Style="{StaticResource DialogButton}"
                            Click="on_add"/>
                    <Button x:Name="BtnEdit" Content="Edit"
                            Style="{StaticResource DialogButton}"
                            Click="on_edit"/>
                    <Button x:Name="BtnRemove" Content="Remove"
                            Style="{StaticResource DialogButton}"
                            Click="on_remove"/>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The list order IS the priority hierarchy: the TOP configuration wins corner posts in Fence Network - Move up / Move down to reorder. Add new and Edit open the configuration editor (double-click a row edits it too); Remove deletes the picked one - the last one standing resets to 'Default'. Configurations live in pyMEP settings and survive updates; Update Fence re-reads them, so an edit here reworks its fences on the next update."/>
            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,6,0,0" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_close"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
