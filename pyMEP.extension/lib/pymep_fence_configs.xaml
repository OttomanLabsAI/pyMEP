<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configurations"
        Width="460" Height="480" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Fence Configurations"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="Named spacing set-ups used by Place New Fence and Update Fence."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <GroupBox Header="Configuration">
                <StackPanel>
                    <ComboBox x:Name="CmbConfig"
                              SelectionChanged="on_pick"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Picking one fills the fields below."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Values">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Name"/>
                        <TextBox x:Name="TxtName" Grid.Row="0"
                                 Grid.Column="1" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing (mm)"/>
                        <TextBox x:Name="TxtSpacing" Grid.Row="1"
                                 Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Rotation (deg)"/>
                        <TextBox x:Name="TxtRotation" Grid.Row="2"
                                 Grid.Column="1"/>
                        <CheckBox x:Name="ChkEnds" Grid.Row="3"
                                  Grid.Column="0" Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="place at the line's endpoints"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Rotation is EXTRA on top of line-aligned: 0 follows the line, 90 stands across it, negative turns the other way."/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="BtnSave" Content="Save / update"
                                Style="{StaticResource DialogButton}"
                                Click="on_save"/>
                        <Button x:Name="BtnDelete" Content="Delete"
                                Style="{StaticResource DialogButton}"
                                Click="on_delete"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Save stores the fields under the Name - a NEW name creates a new configuration. Configurations live in pyMEP settings and survive updates; Update Fence re-reads them, so editing one here re-spaces its fences on the next update."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_close"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
