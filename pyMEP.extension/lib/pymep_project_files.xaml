<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Files"
        Width="640" Height="420" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Project Files"/>
                <TextBlock x:Name="TxtProject" Style="{StaticResource Hint}"
                           Text="&#8212;"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ListView x:Name="LstFiles" Height="200"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="What" Width="260"
                                DisplayMemberBinding="{Binding [label]}"/>
                            <GridViewColumn Header="Stored file" Width="180"
                                DisplayMemberBinding="{Binding [file]}"/>
                            <GridViewColumn Header="Status" Width="80"
                                DisplayMemberBinding="{Binding [status]}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Files are COPIED into this project's own folder (the original stays put) and the pyMEP buttons pick them up from there - the Civil 3D Export Dashboard opens the stored dashboard data by default."/>
                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Text="" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button x:Name="BtnSet" Content="Set / replace file..."
                        Style="{StaticResource SideButton}" Click="on_set"/>
                <Button x:Name="BtnOpen" Content="Open file"
                        Style="{StaticResource SideButton}" Click="on_open"/>
                <Button x:Name="BtnFolder" Content="Open folder"
                        Style="{StaticResource SideButton}"
                        Click="on_folder"/>
                <Button x:Name="BtnRemove" Content="Remove"
                        Style="{StaticResource SideButton}"
                        Click="on_remove"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_close"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
