<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Place New Fence"
        Width="560" Height="640" MinWidth="470" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Place New Fence - families along a line, on the terrain"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="&#8212;"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,12">
            <GroupBox Header="Fence configuration">
                <StackPanel>
                    <ComboBox x:Name="CmbConfig"
                              SelectionChanged="on_config_pick"/>
                    <TextBlock x:Name="TxtCfgSummary" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="&#8212;"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Post family, foundation family, spacing, endpoints and rotation all come from the picked configuration - create and edit them with the Fence Configs button. Instances follow the line's direction plus the configuration's rotation."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Justification">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="RadJustStart" Content="Start"
                                     GroupName="just" IsChecked="True"
                                     Margin="0,2,16,0"/>
                        <RadioButton x:Name="RadJustCentre" Content="Centre"
                                     GroupName="just" Margin="0,2,16,0"/>
                        <RadioButton x:Name="RadJustEnd" Content="End"
                                     GroupName="just" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Which end of the line the spacing counts from. Centre anchors the pattern to the middle, so the leftover splits evenly between both ends."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Place"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
