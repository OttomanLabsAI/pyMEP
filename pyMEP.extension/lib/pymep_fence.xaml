<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence"
        Width="520" Height="720" MinWidth="470" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="8,3,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Fence - families along a line, on the terrain"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="&#8212;"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,12">
            <GroupBox Header="Family to place">
                <StackPanel>
                    <TextBox x:Name="TxtFamilySearch"
                             TextChanged="on_family_search"/>
                    <ComboBox x:Name="CmbFamily" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Type to filter the list (family : type). The family's X axis is rotated to follow the line's direction at each point."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Spacing configuration">
                <StackPanel>
                    <ComboBox x:Name="CmbConfig"
                              SelectionChanged="on_config_pick"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing (mm)"/>
                        <TextBox x:Name="TxtSpacing" Grid.Column="1"/>
                        <CheckBox x:Name="ChkEnds" Grid.Column="2"
                                  Margin="12,9,0,0"
                                  Content="place at the endpoints"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Picking a configuration fills the fields; Place uses whatever the FIELDS say, saved or not."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Justification">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="RadJustStart" Content="Start"
                                     GroupName="just" IsChecked="True"
                                     Margin="0,2,16,0"/>
                        <RadioButton x:Name="RadJustCentre" Content="Centre"
                                     GroupName="just" Margin="0,2,16,0"/>
                        <RadioButton x:Name="RadJustEnd" Content="End"
                                     GroupName="just" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Which end of the line the spacing counts from. Centre anchors the pattern to the middle, so the leftover splits evenly between both ends."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Configurations - create, edit, delete">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Name"/>
                        <TextBox x:Name="TxtCfgName" Grid.Column="1"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnCfgSave" Content="Save / update"
                                Style="{StaticResource SmallButton}"
                                Click="on_cfg_save"/>
                        <Button x:Name="BtnCfgDelete" Content="Delete"
                                Style="{StaticResource SmallButton}"
                                Click="on_cfg_delete"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Save stores the spacing + endpoints fields above under this name (a NEW name creates a new configuration); Delete removes the one picked in the dropdown. Configurations live in pyMEP settings and survive updates."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Place"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
