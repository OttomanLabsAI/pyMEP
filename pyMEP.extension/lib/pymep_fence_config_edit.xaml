<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configuration"
        Width="480" Height="620" MinWidth="440" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="15"
                           FontWeight="SemiBold"
                           Text="Fence configuration"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Save stores these values under the Name - changing the Name renames the configuration."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,0">
            <GroupBox Header="Values">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Name"/>
                        <TextBox x:Name="TxtName" Grid.Row="0"
                                 Grid.Column="1" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing (mm)"/>
                        <TextBox x:Name="TxtSpacing" Grid.Row="1"
                                 Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Rotation (deg)"/>
                        <TextBox x:Name="TxtRotation" Grid.Row="2"
                                 Grid.Column="1"/>
                        <CheckBox x:Name="ChkEnds" Grid.Row="3"
                                  Grid.Column="0" Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="place at the line's endpoints"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Rotation is EXTRA on top of line-aligned: 0 follows the line, 90 stands across it, negative turns the other way."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Post family">
                <StackPanel>
                    <TextBox x:Name="TxtPostSearch"
                             TextChanged="on_post_search"/>
                    <ComboBox x:Name="CmbPost" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Generic Models, Columns and Structural Columns (type above to filter, family : type). '(none)' places foundations only."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Foundation under every post">
                <StackPanel>
                    <TextBox x:Name="TxtFoundSearch"
                             TextChanged="on_found_search"/>
                    <ComboBox x:Name="CmbFoundation" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Structural Foundation families only (type above to filter). '(none)' places posts only. The foundation lands at the SAME draped point and rotation as the post."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="Save"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_save"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
