<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configuration"
        Width="480" Height="680" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="15"
                           FontWeight="SemiBold"
                           Text="Fence configuration"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Save stores these values under the Name - changing the Name renames the configuration."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,0">
            <GroupBox Header="Name">
                <TextBox x:Name="TxtName"/>
            </GroupBox>

            <GroupBox Header="Line style (Fence Network)">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Line style"/>
                        <ComboBox x:Name="CmbLineStyle" Grid.Row="0"
                                  Grid.Column="1" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Priority (1 = highest)"/>
                        <TextBox x:Name="TxtPriority" Grid.Row="1"
                                 Grid.Column="1" Width="130"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Fence Network models lines drawn with this style using this configuration; at a corner the SMALLEST priority number wins the end post (put the impact rated one at 1). Place New Fence ignores these."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Spacing">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing (mm)"/>
                        <TextBox x:Name="TxtSpacing" Grid.Row="0"
                                 Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Rotation (deg)"/>
                        <TextBox x:Name="TxtRotation" Grid.Row="1"
                                 Grid.Column="1"/>
                        <CheckBox x:Name="ChkEnds" Grid.Row="2"
                                  Grid.Column="0" Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="place at the line's endpoints"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Rotation is EXTRA on top of line-aligned: 0 follows the line, 90 stands across it, negative turns the other way."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Post family">
                <StackPanel>
                    <TextBox x:Name="TxtPostSearch"
                             TextChanged="on_post_search"/>
                    <ComboBox x:Name="CmbPost" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Generic Models, Columns and Structural Columns (type above to filter, family : type). '(none)' places foundations only."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Foundation family">
                <StackPanel>
                    <TextBox x:Name="TxtFoundSearch"
                             TextChanged="on_found_search"/>
                    <ComboBox x:Name="CmbFoundation" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Structural Foundation families only (type above to filter). '(none)' places posts only. Lands at the SAME draped point and rotation as the post."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="End posts">
                <StackPanel>
                    <CheckBox x:Name="ChkSameEnds" Margin="0,2,0,0"
                              IsChecked="True"
                              Content="keep them the same as the in-between posts"
                              Checked="on_same_ends"
                              Unchecked="on_same_ends"/>
                    <StackPanel x:Name="PnlEnds" Margin="0,6,0,0">
                        <TextBlock Text="End post family"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                        <TextBox x:Name="TxtEndPostSearch"
                                 TextChanged="on_end_post_search"/>
                        <ComboBox x:Name="CmbEndPost"
                                  Margin="0,6,0,0"/>
                        <TextBlock Text="End foundation family"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"/>
                        <TextBox x:Name="TxtEndFoundSearch"
                                 TextChanged="on_end_found_search"/>
                        <ComboBox x:Name="CmbEndFoundation"
                                  Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Untick to give the line's ENDPOINT stations their own post + foundation (gate / corner posts, heavier piles). In Fence Network the end FOUNDATION family's 'Diameter' parameter sets the corner circle: the first post of each line is placed so the two foundation circles TOUCH at a single point. No Diameter parameter found - the line draws normally and its first post is skipped."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="Save"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_save"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
