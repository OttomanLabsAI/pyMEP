<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence Configuration"
        Width="560" Height="960" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="15"
                           FontWeight="SemiBold"
                           Text="Fence configuration"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Save stores these values under the Name - changing the Name renames the configuration."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,0">
            <GroupBox Header="Name">
                <TextBox x:Name="TxtName"/>
            </GroupBox>

            <GroupBox Header="Line style (Fence Network)">
                <StackPanel>
                    <ComboBox x:Name="CmbLineStyle" Margin="0,3,0,0"/>
                    <CheckBox x:Name="ChkEndPriority" Margin="0,8,0,0"
                              Content="endpoint PRIORITY at corners (double post)"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Fence Network models lines drawn with this style using this configuration; corners form at EVERY intersection of the lines, and the configuration nearer the TOP of the list wins the corner's end post - reorder with Move up / Move down. With endpoint PRIORITY ticked, other lines TERMINATING at this configuration's corners place their OWN end post right next to it on their line - offset so the two end foundation circles touch (family Diameter parameters). Place New Fence ignores all of this."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Spacing">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing (mm)"/>
                        <TextBox x:Name="TxtSpacing" Grid.Row="0"
                                 Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Rotation (deg)"/>
                        <TextBox x:Name="TxtRotation" Grid.Row="1"
                                 Grid.Column="1"/>
                        <CheckBox x:Name="ChkEnds" Grid.Row="2"
                                  Grid.Column="0" Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="place at the line's endpoints"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Rotation is EXTRA on top of line-aligned: 0 follows the line, 90 stands across it, negative turns the other way. MARK numbering lives on the Fence Configurations list - tick it there per configuration."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Post family">
                <StackPanel>
                    <TextBox x:Name="TxtPostSearch"
                             TextChanged="on_post_search"/>
                    <ComboBox x:Name="CmbPost" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Generic Models, Columns and Structural Columns (type above to filter, family : type). '(none)' places foundations only."/>
                    <CheckBox x:Name="ChkSameEnds" Margin="0,10,0,0"
                              IsChecked="True"
                              Content="END posts + foundations: keep the same as the in-between"
                              Checked="on_same_ends"
                              Unchecked="on_same_ends"/>
                    <StackPanel x:Name="PnlEndPost" Margin="0,6,0,0">
                        <TextBlock Text="End post family"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtEndPostSearch"
                                 TextChanged="on_end_post_search"/>
                        <ComboBox x:Name="CmbEndPost"
                                  Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Untick above to give the line's ENDPOINT stations their own post (gate / corner posts)."/>
                    </StackPanel>
                    <TextBlock Text="Populate parameters"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"/>
                    <TextBox x:Name="TxtPostParams" Height="72"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="One per line: Parameter = equation - written onto every placed POST (and end post). The equation may use the post's OWN parameters by name, z (ground level, mm), e / n (survey, metres), the math functions, or quoted TEXT for text parameters. Examples: Foundation Depth = 750 | Height = 3200 | Offset from Host = z"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Foundation family">
                <StackPanel>
                    <TextBox x:Name="TxtFoundSearch"
                             TextChanged="on_found_search"/>
                    <ComboBox x:Name="CmbFoundation" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Structural Foundation families only (type above to filter). '(none)' places posts only. Lands at the SAME draped point and rotation as the post."/>
                    <StackPanel x:Name="PnlEndFound" Margin="0,10,0,0">
                        <TextBlock Text="End foundation family"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtEndFoundSearch"
                                 TextChanged="on_end_found_search"/>
                        <ComboBox x:Name="CmbEndFoundation"
                                  Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Greys with the tick in Post family. In Fence Network this family's 'Diameter' parameter sets the corner circle - each line's first post is placed so the two foundation circles TOUCH at a single point (no Diameter parameter: normal spacing, first post skipped)."/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Easting parameter"/>
                        <TextBox x:Name="TxtEastParam" Grid.Row="0"
                                 Grid.Column="1" Width="180"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Northing parameter"/>
                        <TextBox x:Name="TxtNorthParam" Grid.Row="1"
                                 Grid.Column="1" Width="180"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Every placed foundation gets its SURVEY coordinates written into these instance parameters (defaults: EASTINGS / NORTHINGS). A Length parameter shows the project units, a Text parameter gets metres to 3 decimals; families without the parameters are left alone. Update Fence refreshes them on moves and rebuilds."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Fence panel family">
                <StackPanel>
                    <TextBox x:Name="TxtPanelSearch"
                             TextChanged="on_panel_search"/>
                    <ComboBox x:Name="CmbPanel" Margin="0,6,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Spacing parameter"/>
                        <TextBox x:Name="TxtPanelParam"
                                 Grid.Column="1" Width="180"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Generic Models and Structural Framing, point-based (type above to filter). '(none)' places no panels. One panel per BAY between consecutive posts: placed at the bay's CENTRE, aligned to the line, draped like the posts. The SPACING PARAMETER names the family parameter that receives the bay length (the spacing; shorter on the last bay) - leave it empty to try Width / Panel Width / Length automatically. Bays under 100 mm (touching double posts) get none."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Terrain">
                <StackPanel>
                    <RadioButton x:Name="RbTerrainAuto"
                                 GroupName="TerrainMode"
                                 IsChecked="True"
                                 Content="AUTO - use the topo(s) the lines sit over (default)"/>
                    <RadioButton x:Name="RbTerrainPick"
                                 GroupName="TerrainMode"
                                 Margin="0,6,0,0"
                                 Content="pick the terrain when the button runs"/>
                    <RadioButton x:Name="RbTerrainNamed"
                                 GroupName="TerrainMode"
                                 Margin="0,6,0,0"
                                 Content="always these terrain element(s):"
                                 Checked="on_terrain_mode"
                                 Unchecked="on_terrain_mode"/>
                    <StackPanel x:Name="PnlTerrains"
                                Margin="18,6,0,0">
                        <TextBox x:Name="TxtTerrainSearch"
                                 TextChanged="on_terrain_search"/>
                        <ListBox x:Name="LstTerrains" Height="96"
                                 Margin="0,6,0,0"
                                 SelectionMode="Multiple"
                                 SelectionChanged="on_terrain_pick"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Where the fence drapes to. AUTO (the default) finds every toposolid / topography whose footprint the lines touch. The named list (toposolids, topographies, floors, roofs - type above to filter, click to tick several) matches elements by NAME, so it survives between models. When AUTO finds nothing or a named terrain is missing, the button falls back to asking for a pick. Fence Network takes the terrain from the highest-priority configuration among the picked lines."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="Save"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_save"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
