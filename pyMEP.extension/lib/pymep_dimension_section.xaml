<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimension Section"
        Width="640" Height="760" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Dimension Section"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="Adds the strings in the list below to each section: reference plane strings and pipe / conduit / duct centreline strings."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,0">
                <GroupBox x:Name="GrpSections" Header="Sections to dimension">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Search"/>
                            <TextBox x:Name="TxtFilter" Grid.Column="1"
                                     TextChanged="on_filter"/>
                            <Button x:Name="BtnAll" Grid.Column="2"
                                    Content="All" Margin="10,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_all"/>
                            <Button x:Name="BtnNone" Grid.Column="3"
                                    Content="None" Margin="6,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_none"/>
                        </Grid>
                        <CheckBox x:Name="ChkAllProject" Margin="0,8,0,0"
                                  Content="list every section in the project, not just this sheet's"
                                  Checked="on_scope_changed"
                                  Unchecked="on_scope_changed"/>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,6,0,0" Background="White">
                            <ScrollViewer Height="170"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlSections"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtCount"
                                   Style="{StaticResource Hint}"
                                   Text=""/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Dimension type">
                    <StackPanel>
                        <ComboBox x:Name="CmbDimType"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A linear dimension type from this project. Every string in every section uses it. Remembered for next time."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Dimensions to add">
                    <StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,10,0" Text="Saved set"/>
                            <ComboBox x:Name="CmbDimSet" Grid.Column="1"
                                      SelectionChanged="on_set_changed"/>
                            <Button x:Name="BtnSetSave" Grid.Column="2" Content="Save as..."
                                    MinWidth="86" Margin="8,0,0,0" Padding="10,3"
                                    Click="on_set_save"/>
                            <Button x:Name="BtnSetDelete" Grid.Column="3" Content="Delete"
                                    MinWidth="70" Margin="8,0,0,0" Padding="10,3"
                                    Click="on_set_delete"/>
                        </Grid>
                        <Border x:Name="PnlSetSave" BorderBrush="#ABADB3" BorderThickness="1"
                                Padding="10,8" Margin="0,6,0,0" Background="#FAFAFA"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,10,0" Text="Save the pipe tick and the list below as"/>
                                <TextBox x:Name="TxtSetName" Grid.Column="1"/>
                                <Button x:Name="BtnSetSaveOk" Grid.Column="2" Content="Save"
                                        MinWidth="80" Margin="8,0,0,0" Padding="10,3"
                                        Click="on_set_save_ok"/>
                                <Button x:Name="BtnSetSaveCancel" Grid.Column="3" Content="Cancel"
                                        MinWidth="70" Margin="8,0,0,0" Padding="10,3"
                                        Click="on_set_save_cancel"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TxtSetStatus" Style="{StaticResource Hint}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" Text=""/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="Strings to add - reference planes (the chamber family's x1, x2..., y1, y2... or z1, z2...) or pipe / conduit / duct centrelines:"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="LstRules" Grid.Column="0" Height="96"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="BtnRuleAdd" Content="+" Width="64"
                                        FontWeight="Bold" Click="on_rule_add"/>
                                <Button x:Name="BtnRuleEdit" Content="Edit" Width="64"
                                        Margin="0,6,0,0" Click="on_rule_edit"/>
                                <Button x:Name="BtnRuleRemove" Content="Remove" Width="64"
                                        Margin="0,6,0,0" Click="on_rule_remove"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="PnlRuleEditor" BorderBrush="#ABADB3"
                                BorderThickness="1" Padding="10,8" Margin="0,8,0,0"
                                Background="#FAFAFA" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Margin="0,0,10,0" Text="String"/>
                                    <RadioButton x:Name="RbKindPlanes" GroupName="RuleKind"
                                                 VerticalAlignment="Center" Checked="on_kind_changed"
                                                 Content="reference planes"/>
                                    <RadioButton x:Name="RbKindPipes" GroupName="RuleKind"
                                                 Margin="14,0,0,0" VerticalAlignment="Center"
                                                 Checked="on_kind_changed"
                                                 Content="pipe / conduit / duct centrelines"/>
                                </StackPanel>
                                <StackPanel x:Name="PnlPlanesFields" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Margin="0,0,10,0" Text="Planes"/>
                                    <RadioButton x:Name="RbAxisZ" GroupName="Axis"
                                                 VerticalAlignment="Center"
                                                 Content="z (levels)"/>
                                    <RadioButton x:Name="RbAxisX" GroupName="Axis"
                                                 Margin="14,0,0,0" VerticalAlignment="Center"
                                                 Content="x"/>
                                    <RadioButton x:Name="RbAxisY" GroupName="Axis"
                                                 Margin="14,0,0,0" VerticalAlignment="Center"
                                                 Content="y"/>
                                </StackPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Numbers"/>
                                    <TextBox x:Name="TxtSpec" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Hint}"
                                               Margin="10,6,0,0"
                                               Text="1-5, 1- (to the highest), all, or 2,3,5"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="RbRuleChain" GroupName="RuleMode"
                                                 Content="chain through each plane"/>
                                    <RadioButton x:Name="RbRuleDirect" GroupName="RuleMode"
                                                 Margin="18,0,0,0"
                                                 Content="one overall dimension, first to last"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkRuleSkip" Margin="0,8,0,0"
                                          Content="dimension anyway when a plane is missing or this view cannot take it - use the ones it can"/>
                                <CheckBox x:Name="ChkRuleInside" Margin="0,6,0,0"
                                          Content="only planes within the chamber's visible outline - drop one that reaches beyond what is drawn"/>
                                </StackPanel>
                                <StackPanel x:Name="PnlPipesFields" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,10,0" Text="Of"/>
                                        <CheckBox x:Name="ChkCatPipe" VerticalAlignment="Center"
                                                  Content="pipes"/>
                                        <CheckBox x:Name="ChkCatConduit" Margin="14,0,0,0"
                                                  VerticalAlignment="Center" Content="conduits"/>
                                        <CheckBox x:Name="ChkCatDuct" Margin="14,0,0,0"
                                                  VerticalAlignment="Center" Content="ducts"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkPipeCols" Margin="0,8,0,0"
                                              Content="column spacing - one string above the bank through the top centreline of each column"/>
                                    <CheckBox x:Name="ChkPipeRows" Margin="0,6,0,0"
                                              Content="row spacing - one string to the left of the bank through the leftmost centreline of each row"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Only runs passing through the chamber count; a single column or a single row gets no string."/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtRuleStatus" Grid.Column="0"
                                               Foreground="#B00020" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Text=""/>
                                    <Button x:Name="BtnRuleSave" Grid.Column="1"
                                            Content="Add to list" MinWidth="96"
                                            Padding="10,3" Click="on_rule_save"/>
                                    <Button x:Name="BtnRuleCancel" Grid.Column="2"
                                            Content="Cancel" MinWidth="80"
                                            Margin="8,0,0,0" Padding="10,3"
                                            Click="on_rule_cancel"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Each rule is one string per section, in number order: z strings to the right of the chamber, x and y strings below it, stacked when there are several. The planes must be named in the family and set as a reference."/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Dimension"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
