<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimension Section"
        Width="600" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Dimension Section"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="Two chained dimensions through the pipe centrelines: column spacing above the bank, row spacing to its left."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,0">
                <GroupBox x:Name="GrpSections" Header="Sections to dimension">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Search"/>
                            <TextBox x:Name="TxtFilter" Grid.Column="1"
                                     TextChanged="on_filter"/>
                            <Button x:Name="BtnAll" Grid.Column="2"
                                    Content="All" Margin="10,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_all"/>
                            <Button x:Name="BtnNone" Grid.Column="3"
                                    Content="None" Margin="6,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_none"/>
                        </Grid>
                        <CheckBox x:Name="ChkAllProject" Margin="0,8,0,0"
                                  Content="list every section in the project, not just this sheet's"
                                  Checked="on_scope_changed"
                                  Unchecked="on_scope_changed"/>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,6,0,0" Background="White">
                            <ScrollViewer Height="170"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlSections"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtCount"
                                   Style="{StaticResource Hint}"
                                   Text=""/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Dimension type">
                    <StackPanel>
                        <ComboBox x:Name="CmbDimType"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A linear dimension type from this project. Both strings in every section use it. Remembered for next time."/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Dimension"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
