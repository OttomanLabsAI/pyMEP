<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate"
        Width="640" Height="640" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Annotate"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="One label per bank of parallel runs."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <GroupBox Header="Label">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Prefix"/>
                        <TextBox x:Name="TxtPrefix" Grid.Row="0"
                                 Grid.Column="1"
                                 TextChanged="on_changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Text type"/>
                        <ComboBox x:Name="CmbTextType" Grid.Row="1"
                                  Grid.Column="1" Height="24"
                                  Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Bank gap (mm)"/>
                        <TextBox x:Name="TxtBankGap" Grid.Row="2"
                                 Grid.Column="1" Width="120"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The prefix is free text (e.g. HV, COMMS) - leave it empty to drop it from the label. BANK GAP is how far apart two runs may sit, surface to surface, and still be labelled as ONE bank."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Order">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource Hint}"
                                   Text="suffix"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="1."/>
                        <ComboBox x:Name="CmbSlot1" Grid.Row="1"
                                  Grid.Column="1" Height="24"
                                  Margin="0,3,0,0"
                                  SelectionChanged="on_slot_changed"/>
                        <TextBox x:Name="TxtSuf1" Grid.Row="1"
                                 Grid.Column="2" Margin="8,3,0,0"
                                 TextChanged="on_suffix_changed"/>
                        <CheckBox x:Name="ChkBreak1" Grid.Row="1"
                                  Grid.Column="3" Margin="10,8,0,0"
                                  Content="new line after"
                                  Checked="on_changed"
                                  Unchecked="on_changed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="2."/>
                        <ComboBox x:Name="CmbSlot2" Grid.Row="2"
                                  Grid.Column="1" Height="24"
                                  Margin="0,3,0,0"
                                  SelectionChanged="on_slot_changed"/>
                        <TextBox x:Name="TxtSuf2" Grid.Row="2"
                                 Grid.Column="2" Margin="8,3,0,0"
                                 TextChanged="on_suffix_changed"/>
                        <CheckBox x:Name="ChkBreak2" Grid.Row="2"
                                  Grid.Column="3" Margin="10,8,0,0"
                                  Content="new line after"
                                  Checked="on_changed"
                                  Unchecked="on_changed"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="3."/>
                        <ComboBox x:Name="CmbSlot3" Grid.Row="3"
                                  Grid.Column="1" Height="24"
                                  Margin="0,3,0,0"
                                  SelectionChanged="on_slot_changed"/>
                        <TextBox x:Name="TxtSuf3" Grid.Row="3"
                                 Grid.Column="2" Margin="8,3,0,0"
                                 TextChanged="on_suffix_changed"/>
                        <CheckBox x:Name="ChkBreak3" Grid.Row="3"
                                  Grid.Column="3" Margin="10,8,0,0"
                                  Content="new line after"
                                  Checked="on_changed"
                                  Unchecked="on_changed"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="4."/>
                        <ComboBox x:Name="CmbSlot4" Grid.Row="4"
                                  Grid.Column="1" Height="24"
                                  Margin="0,3,0,0"
                                  SelectionChanged="on_slot_changed"/>
                        <TextBox x:Name="TxtSuf4" Grid.Row="4"
                                 Grid.Column="2" Margin="8,3,0,0"
                                 TextChanged="on_suffix_changed"/>
                    </Grid>
                    <CheckBox x:Name="ChkSwap" Margin="0,8,0,0"
                              Content="swap the combination - write UP x ACROSS (a row of 4 reads 1x4 instead of 4x1)"
                              Checked="on_changed"
                              Unchecked="on_changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Each part appears once, in the order above; set a slot to (none) to leave it out. The SUFFIX box is written straight after its part with no space - the diameter starts with the diameter symbol; type ' mm' (with the space), 'dia' or anything else instead, and a suffix follows its part when you reorder. COMBINATION is the bank measured ACROSS x UP (2 side by side and 2 stacked reads 2x2); a bank that does not fill a rectangle is counted instead (3 no.). DIAMETER lists every size in the bank when they differ. SLOPE only ever prints on pipes."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Preview">
                <StackPanel>
                    <Border Background="#F8F8F8" Padding="10,8"
                            BorderBrush="#DDDDDD" BorderThickness="1">
                        <TextBlock x:Name="TxtPreview" FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Text=""/>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="An example label for a bank of TWO runs side by side, 150 mm, falling at 1:150 - the swap tick flips its combination."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Annotate"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
