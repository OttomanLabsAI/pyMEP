<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kerb"
        Width="560" Height="520" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Kerb"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="Kerb units along a line, draped onto the terrain."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="14,12,14,0">
            <GroupBox Header="Kerb family">
                <StackPanel>
                    <TextBox x:Name="TxtKerbSearch"
                             TextChanged="on_kerb_search"/>
                    <ComboBox x:Name="CmbKerb" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Generic Models, Structural Framing and Site families (type above to filter, family : type)."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Layout">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Unit length (mm)"/>
                        <TextBox x:Name="TxtLength" Grid.Row="0"
                                 Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Angle parameter"/>
                        <ComboBox x:Name="CmbAngleParam" Grid.Row="1"
                                  Grid.Column="1" Grid.ColumnSpan="2"
                                  IsEditable="True" Height="24"
                                  Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Length parameter"/>
                        <ComboBox x:Name="CmbLenParam" Grid.Row="2"
                                  Grid.Column="1" Grid.ColumnSpan="2"
                                  IsEditable="True" Height="24"
                                  Margin="0,3,0,0"/>
                        <CheckBox x:Name="ChkSlopeFit" Grid.Row="3"
                                  Grid.Column="0" Grid.ColumnSpan="3"
                                  Margin="0,10,0,0"
                                  Content="slope fit - place units TOUCHING on the slope (Pythagoras)"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Units lay END-TO-END from the line's start; the leftover shortens the LAST unit. Each unit sits at its bay's centre, rotated to the line (a curve gets the curve's tangent there). The dropdowns list the PICKED FAMILY's own parameters (typing a name works too). The terrain's slope ALONG the line is written to the ANGLE parameter (-90..+90 deg, positive climbs). With SLOPE FIT on, each unit's PLAN advance shrinks to sqrt(length&#178; - rise&#178;) - the unit is the hypotenuse lying on the ground, so consecutive units TOUCH instead of leaving gaps on slopes; off keeps the flat plan spacing. The LENGTH parameter (optional) receives each unit's true length; the last one comes up short."/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusText" Foreground="#B00020"
                       TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Place"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
