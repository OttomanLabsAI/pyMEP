<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamber Sheet Setup"
        Width="600" Height="770" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Chamber Sheet Setup"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="One row per chamber: its plan first, then its sections A, B, C..."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,0">
                <GroupBox Header="Chambers to place">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Search"/>
                            <TextBox x:Name="TxtFilter" Grid.Column="1"
                                     TextChanged="on_filter"/>
                            <Button x:Name="BtnAll" Grid.Column="2"
                                    Content="All" Margin="10,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_all"/>
                            <Button x:Name="BtnNone" Grid.Column="3"
                                    Content="None" Margin="6,3,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Click="on_tick_none"/>
                        </Grid>
                        <Border BorderBrush="#ABADB3" BorderThickness="1"
                                Margin="0,6,0,0" Background="White">
                            <ScrollViewer Height="190"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlMarks"
                                            Margin="6,4,6,4"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtCount"
                                   Style="{StaticResource Hint}"
                                   Text=""/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A chamber is known by the part of its Mark before the slash (LV1 for LV1/Z1). Every plan and section whose name carries that key is placed: the plan(s) first, then the sections in SIDE letter order. Views already on a sheet are skipped and reported."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Layout">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Scale"/>
                            <ComboBox x:Name="CmbScale" Grid.Column="1"
                                      IsEditable="True"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Gap between views (mm)"/>
                            <TextBox x:Name="TxtGap" Grid.Column="3"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Left margin (mm)"/>
                            <TextBox x:Name="TxtLeft" Grid.Column="1"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Top margin (mm)"/>
                            <TextBox x:Name="TxtTop" Grid.Column="3"/>
                            <TextBlock Grid.Column="4"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Title room (mm)"/>
                            <TextBox x:Name="TxtLabel" Grid.Column="5"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The scale is set on every placed view first (a view whose template locks the scale is reported). Views run left to right from the top-left of the sheet; a row that would pass the right edge wraps to a new line; the next chamber starts below the tallest view of the row plus the title room. Margins are measured on the sheet."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="View templates and viewport type">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Plan views"/>
                            <ComboBox x:Name="CmbPlanTemplate" Grid.Row="0"
                                      Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Section views"/>
                            <ComboBox x:Name="CmbSectionTemplate" Grid.Row="1"
                                      Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Viewport type"/>
                            <ComboBox x:Name="CmbViewportType" Grid.Row="2"
                                      Grid.Column="1"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Templates are applied to every placed view before the scale is set; a template that locks the scale wins over the scale above, and the report says so. '(leave as is)' keeps whatever each view has. The viewport type sets the title under each view (title with line, no title, ...)."/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Place views"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
