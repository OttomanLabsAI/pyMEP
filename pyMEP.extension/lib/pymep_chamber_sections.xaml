<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Chamber Sections"
        Width="640" Height="760" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="Create Chamber Sections"/>
                <TextBlock x:Name="TxtInfo"
                           Style="{StaticResource Hint}"
                           Text="One section per chamber side, looking in at the chamber - only the sides that cut pipework."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12,14,0">
                <GroupBox Header="Chambers">
                    <StackPanel>
                        <RadioButton x:Name="RbSelection" GroupName="Source"
                                     Margin="0,4,0,0"
                                     Content="use the selected chamber(s)"
                                     Checked="on_source_changed"/>
                        <RadioButton x:Name="RbType" GroupName="Source"
                                     Margin="0,6,0,0"
                                     Content="pick a chamber family type"
                                     Checked="on_source_changed"/>
                        <StackPanel x:Name="PnlType" Margin="18,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Search"/>
                                <TextBox x:Name="TxtTypeFilter" Grid.Column="1"
                                         TextChanged="on_type_filter"/>
                            </Grid>
                            <ListBox x:Name="LstTypes" Height="110"
                                     Margin="0,6,0,0"
                                     SelectionChanged="on_type_selected"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Chambers of that type (tick the ones to section)"/>
                                <Button x:Name="BtnAll" Grid.Column="1"
                                        Content="All"
                                        Style="{StaticResource SmallButton}"
                                        Click="on_tick_all"/>
                                <Button x:Name="BtnNone" Grid.Column="2"
                                        Content="None"
                                        Style="{StaticResource SmallButton}"
                                        Click="on_tick_none"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Search Marks"/>
                                <TextBox x:Name="TxtMarkFilter" Grid.Column="1"
                                         TextChanged="on_mark_filter"/>
                            </Grid>
                            <Border BorderBrush="#ABADB3" BorderThickness="1"
                                    Margin="0,4,0,0" Background="White">
                                <ScrollViewer Height="110"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PnlChambers"
                                                Margin="6,4,6,4"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="TxtChamberCount"
                                       Style="{StaticResource Hint}"
                                       Text=""/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Section box (mm)">
                    <StackPanel>
                        <RadioButton x:Name="RbSizeFixed" GroupName="Size"
                                     Margin="0,4,0,0"
                                     Content="type the box"
                                     Checked="on_size_mode"/>
                        <Grid x:Name="PnlFixed" Margin="18,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Offset"/>
                            <TextBox x:Name="TxtOffset" Grid.Column="1"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Height"/>
                            <TextBox x:Name="TxtHeight" Grid.Column="3"/>
                            <TextBlock Grid.Column="4"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Depth"/>
                            <TextBox x:Name="TxtDepth" Grid.Column="5"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="18,4,0,0"
                                   Text="OFFSET is how far out from the chamber centre each section plane sits. HEIGHT is the total vertical extent, centred on the chamber. DEPTH is the far clip measured from the plane inward - keep it larger than the offset so the cut reaches through the chamber. The width follows the chamber footprint plus 500 mm each side."/>
                        <RadioButton x:Name="RbSizeParams" GroupName="Size"
                                     Margin="0,10,0,0"
                                     Content="size from the chamber's parameters plus a clearance"
                                     Checked="on_size_mode"/>
                        <Grid x:Name="PnlParams" Margin="18,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Along X"/>
                            <TextBox x:Name="TxtParamX" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Along Y"/>
                            <TextBox x:Name="TxtParamY" Grid.Row="0" Grid.Column="3"/>
                            <TextBlock Grid.Row="0" Grid.Column="4"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="16,6,10,0"
                                       Text="Height"/>
                            <TextBox x:Name="TxtParamH" Grid.Row="0" Grid.Column="5"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="Clearance each side (mm)"/>
                            <TextBox x:Name="TxtClear" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="18,4,0,0"
                                   Text="Names of the chamber's length parameters (instance first, then type) for its size along its own X and Y and its height. Each section is then the chamber plus the clearance on every side: the plane sits at half the chamber plus the clearance, the crop is the chamber plus the clearance each way, and the depth runs through the chamber and the clearance past its far face. A chamber missing a parameter falls back to its bounding box and is reported."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Section type">
                    <StackPanel>
                        <CheckBox x:Name="ChkSameType" Margin="0,4,0,0"
                                  Content="same section type for every side"
                                  Checked="on_same_changed"
                                  Unchecked="on_same_changed"/>
                        <ComboBox x:Name="CmbTypeAll" Margin="0,6,0,0"/>
                        <Grid x:Name="PnlPerSide" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="SIDE A"/>
                            <ComboBox x:Name="CmbTypeA" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="SIDE B"/>
                            <ComboBox x:Name="CmbTypeB" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="SIDE C"/>
                            <ComboBox x:Name="CmbTypeC" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"
                                       Text="SIDE D"/>
                            <ComboBox x:Name="CmbTypeD" Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Per-side types go by the FINAL letter of each section, i.e. the letters left after empty sides are dropped."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pipework check">
                    <StackPanel>
                        <CheckBox x:Name="ChkCutOnly" Margin="0,4,0,0"
                                  Content="only create sides whose section plane cuts pipework"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Each side's plane is tested against every pipe, conduit, duct, cable tray and fitting in the model and its loaded links. Sides that cut nothing are not created and the survivors are named SIDE A, B, C... in order. If no side of a chamber cuts anything, all four are kept. Untick to always create all four sides."/>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="#B00020"
                           TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGo" Content="Create sections"
                        Style="{StaticResource DialogButton}" IsDefault="True"
                        Click="on_go"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="on_cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
