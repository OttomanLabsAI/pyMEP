<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COBie and Uniclass"
        Width="780" Height="840" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold"
                           Text="COBie and Uniclass parameters"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}"
                           Text="Rules decide which elements get which Uniclass codes and COBie values. Dry run reports what would change; Apply writes it in one undo step."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">

            <TabItem Header="1  Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Rules apply top to bottom to every element they match; a later rule overrides an earlier one for the same parameter. Put broad rules (all pipes get this Ss code) above narrow ones (this family gets that Pr code)."/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="LstRules" Grid.Column="0" Height="150"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="BtnRuleAdd" Content="+" Width="72"
                                        FontWeight="Bold" Click="on_rule_add"/>
                                <Button x:Name="BtnRuleEdit" Content="Edit" Width="72"
                                        Style="{StaticResource SmallButton}" Click="on_rule_edit"/>
                                <Button x:Name="BtnRuleRemove" Content="Remove" Width="72"
                                        Style="{StaticResource SmallButton}" Click="on_rule_remove"/>
                                <Button x:Name="BtnRuleUp" Content="Up" Width="72"
                                        Style="{StaticResource SmallButton}" Click="on_rule_up"/>
                                <Button x:Name="BtnRuleDown" Content="Down" Width="72"
                                        Style="{StaticResource SmallButton}" Click="on_rule_down"/>
                                <Button x:Name="BtnRuleToggle" Content="On / off" Width="72"
                                        Style="{StaticResource SmallButton}" Click="on_rule_toggle"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PnlRuleEditor" BorderBrush="#ABADB3"
                                BorderThickness="1" Padding="10,8" Margin="0,8,0,0"
                                Background="#FAFAFA" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Rule name"/>
                                    <TextBox x:Name="TxtRuleName" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Applies to"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Top" Text="Categories"/>
                                    <ListBox x:Name="LstCats" Grid.Column="1" Height="110"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="90,2,0,0"
                                           Text="None ticked = every category in the model."/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Family"/>
                                    <TextBox x:Name="TxtFamily" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="10,6,10,0" Text="Type"/>
                                    <TextBox x:Name="TxtType" Grid.Column="3"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Margin="10,6,10,0" Text="System"/>
                                    <TextBox x:Name="TxtSystem" Grid.Column="5"/>
                                </Grid>
                                <CheckBox x:Name="ChkRegex" Margin="90,6,0,0"
                                          Content="patterns are regular expressions (otherwise: contains, case-insensitive; blank = any)"/>

                                <GroupBox Header="Uniclass" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pr"/>
                                            <TextBox x:Name="TxtPr" Grid.Row="0" Grid.Column="1"/>
                                            <TextBox x:Name="TxtPrTitle" Grid.Row="0" Grid.Column="2" Margin="8,3,0,0"/>
                                            <Button x:Name="BtnFindPr" Grid.Row="0" Grid.Column="3" Content="Find..."
                                                    Margin="8,3,0,0" Padding="8,2" Click="on_find_pr"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Ss"/>
                                            <TextBox x:Name="TxtSs" Grid.Row="1" Grid.Column="1"/>
                                            <TextBox x:Name="TxtSsTitle" Grid.Row="1" Grid.Column="2" Margin="8,3,0,0"/>
                                            <Button x:Name="BtnFindSs" Grid.Row="1" Grid.Column="3" Content="Find..."
                                                    Margin="8,3,0,0" Padding="8,2" Click="on_find_ss"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="EF"/>
                                            <TextBox x:Name="TxtEf" Grid.Row="2" Grid.Column="1"/>
                                            <TextBox x:Name="TxtEfTitle" Grid.Row="2" Grid.Column="2" Margin="8,3,0,0"/>
                                            <Button x:Name="BtnFindEf" Grid.Row="2" Grid.Column="3" Content="Find..."
                                                    Margin="8,3,0,0" Padding="8,2" Click="on_find_ef"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Code on the left, title on the right. Find... searches the loaded tables (tab 3) by code or title words and fills both."/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCodeSearch" Grid.Column="0" TextChanged="on_code_search"/>
                                            <TextBlock x:Name="TxtCodeAxis" Grid.Column="1" Style="{StaticResource Hint}"
                                                       Margin="10,8,0,0" Text="no table loaded"/>
                                        </Grid>
                                        <ListBox x:Name="LstCodes" Height="110" Margin="0,4,0,0"
                                                 SelectionChanged="on_code_pick"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Values to write">
                                    <StackPanel>
                                        <ListBox x:Name="LstValues" Height="130" SelectionChanged="on_value_pick"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtValueParam" Grid.Column="0"/>
                                            <TextBox x:Name="TxtValueTemplate" Grid.Column="1" Margin="8,3,0,0"/>
                                            <Button x:Name="BtnValueSet" Grid.Column="2" Content="Set"
                                                    Margin="8,3,0,0" Padding="10,2" Click="on_value_set"/>
                                            <Button x:Name="BtnValueRemove" Grid.Column="3" Content="Remove"
                                                    Margin="8,3,0,0" Padding="10,2" Click="on_value_remove"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Hint}"
                                                       Text="Parameter name on the left, value on the right. Tokens: {family} {type} {category} {mark} {system} {level} {id} {pr} {pr_title} {ss} {ss_title} {ef} {ef_title} {uniclass} (= pr : title). A value that expands to blank is skipped."/>
                                            <Button x:Name="BtnValueDefaults" Grid.Column="1" Content="Standard set"
                                                    Margin="8,3,0,0" Padding="10,2" Click="on_value_defaults"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtRuleStatus" Grid.Column="0"
                                               Foreground="#B00020" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Text=""/>
                                    <Button x:Name="BtnRuleSave" Grid.Column="1" Content="Add to list"
                                            MinWidth="96" Padding="10,3" Click="on_rule_save"/>
                                    <Button x:Name="BtnRuleCancel" Grid.Column="2" Content="Cancel"
                                            MinWidth="80" Margin="8,0,0,0" Padding="10,3" Click="on_rule_cancel"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2  Parameters">
                <StackPanel Margin="6">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Every parameter the rules write. Kind says where the value goes (instance or type); type says what it holds. Names follow the Autodesk COBie Extension and the NBS / Classification Manager Uniclass set, so an office already using those tools finds its own parameters."/>
                    <ListBox x:Name="LstParams" Height="230" Margin="0,6,0,0"
                             SelectionChanged="on_param_pick"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtParamName" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="(pick a parameter above)"/>
                        <ComboBox x:Name="CmbParamKind" Grid.Column="1" Margin="8,3,0,0"/>
                        <ComboBox x:Name="CmbParamType" Grid.Column="2" Margin="8,3,0,0"/>
                        <Button x:Name="BtnParamApply" Grid.Column="3" Content="Apply"
                                Margin="8,3,0,0" Padding="10,2" Click="on_param_apply"/>
                    </Grid>
                    <CheckBox x:Name="ChkBind" Margin="0,14,0,0"
                              Content="create and bind the parameters that are missing (shared parameters, group 'pyMEP COBie', bound to the rules' categories under Identity Data)"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A parameter that already exists in the project - from the Autodesk COBie Extension, Classification Manager or your template - is used as it is; only its category binding is extended when a rule's category is missing. Parameters pyMEP creates get a GUID derived from the name, so they match across projects."/>
                    <TextBlock x:Name="TxtParamInfo" Style="{StaticResource Hint}" Margin="0,10,0,0" Text=""/>
                </StackPanel>
            </TabItem>

            <TabItem Header="3  Uniclass tables">
                <StackPanel Margin="6">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Point at a folder of CSV exports of the official Uniclass 2015 tables (from the NBS download, saved as CSV). Each file needs a 'Code' column and a 'Title' column; the table (Pr, Ss, EF, ...) is read from the codes. Nothing is bundled - the codes must be the current published ones."/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTablesFolder" Grid.Column="0"/>
                        <Button x:Name="BtnBrowseTables" Grid.Column="1" Content="Browse..."
                                Margin="8,3,0,0" Padding="10,2" Click="on_browse_tables"/>
                        <Button x:Name="BtnLoadTables" Grid.Column="2" Content="Load"
                                Margin="8,3,0,0" Padding="10,2" Click="on_load_tables"/>
                    </Grid>
                    <TextBlock x:Name="TxtTablesInfo" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="No tables loaded. Codes and titles can still be typed by hand in a rule."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="4  Scope">
                <StackPanel Margin="6">
                    <TextBlock Style="{StaticResource Hint}" Text="Which elements the rules are run over."/>
                    <RadioButton x:Name="RbScopeModel" GroupName="Scope" Margin="0,8,0,0"
                                 Content="the whole model (every category the rules name; all model categories for a rule with none)"/>
                    <RadioButton x:Name="RbScopeView" GroupName="Scope" Margin="0,6,0,0"
                                 Content="elements visible in the active view"/>
                    <RadioButton x:Name="RbScopeSelection" GroupName="Scope" Margin="0,6,0,0"
                                 Content="the current selection"/>
                    <CheckBox x:Name="ChkWriteBlanks" Margin="0,14,0,0"
                              Content="write blank values too (clears a parameter when a rule's value expands to nothing)"/>
                    <TextBlock x:Name="TxtScopeInfo" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Type parameters are written once per type, from the first matching element; a later element that would give a different value is reported as a conflict and left."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#F4F4F4" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#B00020"
                           TextWrapping="Wrap" VerticalAlignment="Center" Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnImport" Content="Import rules..."
                            Style="{StaticResource DialogButton}" Click="on_import"/>
                    <Button x:Name="BtnExport" Content="Export rules..."
                            Style="{StaticResource DialogButton}" Click="on_export"/>
                    <Button x:Name="BtnDry" Content="Dry run"
                            Style="{StaticResource DialogButton}" Click="on_dry"/>
                    <Button x:Name="BtnApply" Content="Apply"
                            Style="{StaticResource DialogButton}" IsDefault="True" Click="on_apply"/>
                    <Button x:Name="BtnCancel" Content="Cancel"
                            Style="{StaticResource DialogButton}" IsCancel="True" Click="on_cancel"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
